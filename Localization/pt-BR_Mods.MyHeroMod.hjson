NPCs: {
	SupportVendor: {
		DisplayName: Vendedora de itens de Suporte

		TownNPCMood: {
			Content: Estou contente. Os meus bebês estão funcionando perfeitamente!
			NoHome: Preciso de uma oficina para construir os meus bebês! Não consigo trabalhar assim.
			FarFromHome: Me afastei demaisdas minhas plantas...
			LoveSpace: Adoro este lugar, tem tanto espaço para testar explosões!
			DislikeCrowded: Não gosto disto. muitos pessoas esbarrando nas minhas invenções.
			HateCrowded: Odeio isto! Alguém acabou de pisar o meu bebe mais recente!
			LikeNPC_Princess: A {NPCName} aprecia os meus designs fofinhos!
			Princess_LovesNPC: A {NPCName} gosta mesmo das minhas invenções!
		}
	}

	AllForOneBoss.DisplayName: All For One

