			Summons the Symbol of Evil. 
			"Use to summon the one who rules the underworld."
			'''
	}

	# --- SUPPORT ITEMS ---
	CombatVestAlpha: {
		DisplayName: Combat Vest Alpha
		Tooltip: Decreases the overheating and freezing rates of Fire and Ice Quirks.
	}

	CombatVestBeta: {
		DisplayName: Combat Vest Beta
		Tooltip: Heavily decreases overheating and freezing rates.
	}

