NPCs: {
	SupportVendor: {
		DisplayName: Support Vendor

		TownNPCMood: {
			Content: I'm content. My babies are working perfectly!
			NoHome: I need a workshop to build my babies! I can't work like this.
			FarFromHome: I wandered too far from my blueprints...
			LoveSpace: I love this place, so much room for testing explosions!
			DislikeCrowded: I don't like this. Too many people bumping into my inventions.
			HateCrowded: I hate this! Someone just stepped on my latest baby!
			LikeNPC_Princess: "{NPCName} appreciates my cute designs!"
			Princess_LovesNPC: "{NPCName} really likes my inventions!"
		}
	}

	AllForOneBoss.DisplayName: All For One

	D_Garaki: {
		DisplayName: Dr. Garaki

		TownNPCMood: {
			Content: Science requires... patience. Hehehe.
			NoHome: My laboratory... I need a dark place to hide my Nomus.
			FarFromHome: I am too exposed out here. I must return to the lab.
			LoveSpace: Ah, the perfect isolated space to conduct my... experiments.
			DislikeCrowded: These fools are too loud. I can't concentrate on my research.
			HateCrowded: Get them away! They are ruining my life's work!
			LikeNPC_Princess: "{NPCName} is quite... fascinating."
			Princess_LovesNPC: "{NPCName} is a very polite child."
		}
	}
}
